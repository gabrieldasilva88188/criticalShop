@model CriticalShop.Models.Produto
@{
    ViewData["Title"] = Model.Nome;
    var precoFinal = Model.Desconto != null ? Model.Preco * (1 - Model.Desconto.Valor / 100.0) : Model.Preco;
    var mediaAvaliacoes = Model.Avaliacoes.Any() ? Model.Avaliacoes.Average(a => a.Nota) : 0;
}

<style>
    .product-detail-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 20px;
    }

    .product-header {
        background: linear-gradient(135deg, #232020 0%, #3A3535 100%);
        color: #F4F4F4;
        padding: 30px;
        border-radius: 15px 15px 0 0;
        margin-bottom: 0;
        border-bottom: 3px solid #FF7315;
    }

    .product-header h1 {
        margin: 0;
        font-size: 2.5rem;
        font-weight: bold;
        color: #FF7315;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    .product-category {
        display: inline-block;
        background: rgba(255, 115, 21, 0.2);
        padding: 8px 20px;
        border-radius: 25px;
        margin-top: 10px;
        font-size: 0.9rem;
        color: #FF7315;
        border: 1px solid #FF7315;
    }

    .product-content {
        background: #F4F4F4;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 10px 30px rgba(35, 32, 32, 0.15);
        overflow: hidden;
        border: 2px solid #232020;
    }

    .product-main {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        padding: 40px;
        background: white;
    }

    .product-image-section {
        position: relative;
    }

    .product-image {
        width: 100%;
        height: 500px;
        object-fit: cover;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(35, 32, 32, 0.1);
        border: 2px solid #3A3535;
    }

    .product-image-placeholder {
        width: 100%;
        height: 500px;
        background: linear-gradient(135deg, #F4F4F4 0%, #E8E8E8 100%);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #3A3535;
        border: 2px solid #3A3535;
    }

    .discount-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background: linear-gradient(135deg, #FF7315 0%, #E56712 100%);
        color: #232020;
        padding: 12px 24px;
        border-radius: 25px;
        font-weight: bold;
        font-size: 1.2rem;
        box-shadow: 0 5px 15px rgba(255, 115, 21, 0.4);
        border: 2px solid #232020;
    }

    .product-info-section {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .price-section {
        background: linear-gradient(135deg, #F4F4F4 0%, #E8E8E8 100%);
        padding: 25px;
        border-radius: 15px;
        border-left: 5px solid #FF7315;
        border: 2px solid #3A3535;
    }

    .price-label {
        font-size: 0.9rem;
        color: #3A3535;
        margin-bottom: 5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .price-original {
        text-decoration: line-through;
        color: #6c757d;
        font-size: 1.2rem;
        margin-right: 10px;
    }

    .price-current {
        font-size: 2.5rem;
        font-weight: bold;
        color: #FF7315;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
    }

    .rating-section {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 20px;
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        border-radius: 10px;
        border: 2px solid #FF7315;
    }

    .stars {
        color: #FF7315;
        font-size: 1.5rem;
    }

    .rating-text {
        color: #232020;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 20px;
    }

    .btn-add-cart {
        flex: 1;
        background: linear-gradient(135deg, #FF7315 0%, #E56712 100%);
        color: #232020;
        border: none;
        padding: 18px 30px;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(255, 115, 21, 0.3);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-add-cart:hover {
        background: linear-gradient(135deg, #E56712 0%, #CC5B10 100%);
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(255, 115, 21, 0.4);
        color: #232020;
    }

    .btn-back {
        background: linear-gradient(135deg, #3A3535 0%, #232020 100%);
        color: #F4F4F4;
        border: none;
        padding: 18px 30px;
        border-radius: 10px;
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(35, 32, 32, 0.3);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .btn-back:hover {
        background: linear-gradient(135deg, #232020 0%, #3A3535 100%);
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(35, 32, 32, 0.4);
        color: #F4F4F4;
        text-decoration: none;
    }

    .description-section {
        padding: 40px;
        border-top: 3px solid #FF7315;
        background: white;
    }

    .section-title {
        font-size: 1.8rem;
        font-weight: bold;
        color: #232020;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 3px solid #FF7315;
        display: inline-block;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
    }

    .description-text {
        line-height: 1.8;
        color: #3A3535;
        font-size: 1.1rem;
        text-align: justify;
        white-space: pre-line;
    }

    .specifications-section {
        padding: 40px;
        background: linear-gradient(135deg, #F4F4F4 0%, #E8E8E8 100%);
        border-top: 3px solid #232020;
    }

    .spec-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .spec-card {
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(35, 32, 32, 0.1);
        border-left: 4px solid #FF7315;
        border: 2px solid #3A3535;
        transition: all 0.3s ease;
    }

    .spec-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(255, 115, 21, 0.2);
        border-left-color: #232020;
    }

    .spec-label {
        font-size: 0.9rem;
        color: #3A3535;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    .spec-value {
        font-size: 1.3rem;
        font-weight: bold;
        color: #232020;
    }

    .spec-na {
        color: #6c757d;
        font-style: italic;
    }

    /* Economia destacada */
    .text-success {
        color: #FF7315 !important;
        font-weight: 600;
        font-size: 1rem;
    }

        /* Animações */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .product-main {
        animation: fadeInUp 0.8s ease-out;
    }

    .description-section, .specifications-section {
        animation: fadeInUp 0.6s ease-out 0.3s both;
    }

    @@media (max-width: 768px) {
        .product-main {
            grid-template-columns: 1fr;
            padding: 20px;
        }

        .product-header h1 {
            font-size: 1.8rem;
        }

        .action-buttons {
            flex-direction: column;
        }

        .product-image, .product-image-placeholder {
            height: 300px;
        }

        .price-current {
            font-size: 2rem;
        }

        .btn-add-cart, .btn-back {
            padding: 15px 20px;
            font-size: 1rem;
        }
    }

    @@media (max-width: 480px) {
        .product-detail-container {
            padding: 10px;
            margin: 20px auto;
        }

        .product-header {
            padding: 20px;
        }

        .product-header h1 {
            font-size: 1.5rem;
        }

        .description-section, .specifications-section {
            padding: 20px;
        }

        .spec-grid {
            grid-template-columns: 1fr;
        }

        .price-current {
            font-size: 1.8rem;
        }
    }
</style>

<div class="product-detail-container">
    <!-- Header -->
    <div class="product-header">
        <h1>@Model.Nome</h1>
        @if (Model.Categoria != null)
        {
            <span class="product-category">
                <i class="fas fa-tag"></i> @Model.Categoria.Nome
            </span>
        }
    </div>

    <!-- Conteúdo Principal -->
    <div class="product-content">
        <div class="product-main">
            <!-- Imagem do Produto -->
            <div class="product-image-section">
                @if (!string.IsNullOrEmpty(Model.Img))
                {
                    <img src="@Model.Img" alt="@Model.Nome" class="product-image" />
                }
                else
                {
                    <div class="product-image-placeholder">
                        <div class="text-center">
                            <i class="fas fa-image fa-5x mb-3" style="color: #FF7315;"></i>
                            <p style="color: #3A3535; font-weight: 600;">Imagem não disponível</p>
                        </div>
                    </div>
                }
                
                @if (Model.Desconto != null)
                {
                    <div class="discount-badge">
                        -@Model.Desconto.Valor% OFF
                    </div>
                }
            </div>

            <!-- Informações do Produto -->
            <div class="product-info-section">
                <!-- Preço -->
                <div class="price-section">
                    <div class="price-label">Preço</div>
                    @if (Model.Desconto != null)
                    {
                        <div>
                            <span class="price-original">@Model.Preco.ToString("C")</span>
                            <span class="price-current">@precoFinal.ToString("C")</span>
                        </div>
                        <small class="text-success">
                            <i class="fas fa-piggy-bank"></i> 
                            Economize @((Model.Preco - precoFinal).ToString("C"))
                        </small>
                    }
                    else
                    {
                        <div class="price-current">@Model.Preco.ToString("C")</div>
                    }
                </div>

                <!-- Avaliações -->
                @if (Model.Avaliacoes.Any())
                {
                    <div class="rating-section">
                        <div class="stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(mediaAvaliacoes))
                                {
                                    <i class="fas fa-star"></i>
                                }
                                else
                                {
                                    <i class="far fa-star"></i>
                                }
                            }
                        </div>
                        <span class="rating-text">
                            @mediaAvaliacoes.ToString("F1") (@Model.Avaliacoes.Count @(Model.Avaliacoes.Count == 1 ? "avaliação" : "avaliações"))
                        </span>
                    </div>
                }

                <!-- Botões de Ação -->
                <div class="action-buttons">
                    <button class="btn-add-cart add-to-cart" data-id="@Model.Id">
                        <i class="fas fa-shopping-cart"></i> Adicionar ao Carrinho
                    </button>
                </div>
                
                <a asp-controller="Home" asp-action="Index" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Voltar para a Loja
                </a>
            </div>
        </div>

        <!-- Descrição -->
        @if (!string.IsNullOrEmpty(Model.Descricao))
        {
            <div class="description-section">
                <h2 class="section-title">Descrição Geral</h2>
                <div class="description-text">@Model.Descricao</div>
            </div>
        }

        <!-- Especificações -->
        <div class="specifications-section">
            <h2 class="section-title">Especificações Técnicas</h2>
            <div class="spec-grid">
                @if (!string.IsNullOrEmpty(Model.Conteudo))
                {
                    <div class="spec-card">
                        <div class="spec-label">Conteúdo</div>
                        <div class="spec-value">@Model.Conteudo</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Material))
                {
                    <div class="spec-card">
                        <div class="spec-label">Material</div>
                        <div class="spec-value">@Model.Material</div>
                    </div>
                }

                <div class="spec-card">
                    <div class="spec-label">Peso</div>
                    <div class="spec-value">
                        @if (Model.Peso.HasValue && Model.Peso.Value > 0)
                        {
                            @Model.Peso.Value.ToString("F2") <text>kg</text>
                        }
                        else
                        {
                            <span class="spec-na">Não se aplica</span>
                        }
                    </div>
                </div>

                <div class="spec-card">
                    <div class="spec-label">Dimensões</div>
                    <div class="spec-value">
                        @if (Model.Altura.HasValue && Model.Altura.Value > 0 && 
                             Model.Largura.HasValue && Model.Largura.Value > 0 && 
                             Model.Comprimento.HasValue && Model.Comprimento.Value > 0)
                        {
                            @Model.Altura.Value <text>cm x </text> @Model.Largura.Value <text>cm x </text> @Model.Comprimento.Value <text>cm</text>
                        }
                        else
                        {
                            <span class="spec-na">Não se aplica</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://kit.fontawesome.com/your-fontawesome-kit.js"></script>
<script src="@Url.Content("~/js/carrinho.js")"></script>