@model IEnumerable<CriticalShop.Models.Produto>
@inject CriticalShop.Services.AuthService AuthService
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Critical Shop</title>
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")">
    <link rel="stylesheet" href="@Url.Content("~/css/header.css")">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

@await Html.PartialAsync("~/Views/Shared/Header.cshtml")

<!-- Hero -->
<section class="hero-section" style="background: linear-gradient(rgba(35, 32, 32, 0.7), rgba(35, 32, 32, 0.7)), url('@(ViewBag.CampanhaAtiva == true ? Url.Content("~/images/desconto50Off.png") : Url.Content("~/images/hero-bg.jpg"))') no-repeat center center; background-size: cover;">
    <div class="container">
        <div class="hero-content">
            <h2>Bem-vindo à sua loja de RPG!</h2>
            <p>Encontre os melhores itens para suas campanhas e aventuras épicas.</p>
            <a href="#" class="cta-btn">Explorar Itens</a>
        </div>
    </div>
</section>

<!-- Produtos -->
<section class="featured-products">
    <div class="container">
        <h2 class="section-title">@(string.IsNullOrEmpty(ViewBag.CategoriaSelecionada) ? "Destaques" : ViewBag.CategoriaSelecionada)</h2>
        
        @if (!Model.Any())
        {
            <div class="nenhum-produto">
                <p>Nenhum produto encontrado. Tente ajustar sua busca.</p>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var produto in Model)
                {
                    <partial name="_ProdutoCard" model="produto" />
                }
            </div>
        }
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.querySelector('input[name="searchString"]');
        const searchForm = document.querySelector('.search-form');
        let searchTimer;

        // Busca em tempo real após 500ms sem digitação
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                if (this.value.length === 0 || this.value.length >= 2) {
                    searchForm.submit();
                }
            }, 500);
        });

        // Forçar envio ao pressionar Enter
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                searchForm.submit();
            }
        });
    });
</script>

<script src="@Url.Content("~/js/site.js")"></script>
<script src="@Url.Content("~/js/carrinho.js")"></script>
</body>
</html>