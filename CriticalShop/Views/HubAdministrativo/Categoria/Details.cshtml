@model CriticalShop.Models.Categoria
@{
    ViewData["Title"] = "Detalhes da Categoria";
}
<link rel="stylesheet" href="@Url.Content("~/css/crudProdutos/styleDetails.css")">


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title mb-0">
                            <i class="fas fa-info-circle"></i> Informações da Categoria
                        </h3>
                    </div>
                    <div class="card-body">
                        <!-- Informações Básicas -->
                        <div class="category-info">
                            <div class="info-item">
                                <span class="info-label">
                                    <i class="fas fa-hashtag"></i> ID:
                                </span>
                                <span class="info-value">@Model.Id</span>
                            </div>
                            
                            <div class="info-item">
                                <span class="info-label">
                                    <i class="fas fa-tag"></i> Nome:
                                </span>
                                <span class="info-value">@Model.Nome</span>
                            </div>
                            
                            <div class="info-item">
                                <span class="info-label">
                                    <i class="fas fa-sitemap"></i> Categoria Pai:
                                </span>
                                <span class="info-value">
                                    @if (Model.Parent != null)
                                    {
                                        <span class="badge bg-primary">@Model.Parent.Nome</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </span>
                            </div>
                        </div>

                        <!-- Subcategorias -->
                        @if (Model.SubCategorias != null && Model.SubCategorias.Any())
                        {
                           
                                <h5 class="section-title">
                                    <i class="fas fa-network-wired"></i> Subcategorias
                                </h5>
                                <div class="subcategories-list">
                                    @foreach (var sub in Model.SubCategorias)
                                    {
                                        <div class="subcategory-item">
                                            <i class="fas fa-folder"></i>
                                            <span>@sub.Nome</span>
                                            <span class="badge bg-secondary">ID: @sub.Id</span>
                                        </div>
                                    }
                                </div>
                          
                        }
                        else
                        {
                            <div class="no-subcategories mt-4">
                                
                                    <i class="fas fa-folder-minus fa-2x mb-2"></i>
                                    <p>Nenhuma subcategoria encontrada</p>
                                
                            </div>
                        }

                        <!-- Botões de Ação -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Categorias" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Voltar à Lista
                            </a>
                            <div class="btn-group">
                                <a asp-action="EditarCategoria" asp-route-id="@Model.Id" class="btn btn-warning">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <a asp-action="ExcluirCategoria" asp-route-id="@Model.Id" class="btn btn-danger">
                                    <i class="fas fa-trash"></i> Excluir
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


@section Scripts {
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js"></script>
}