@{
    ViewData["Title"] = "Hub Administrativo";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Hub Administrativo</h2>
                <div>
                    <span class="badge bg-primary">Bem-vindo, @ViewBag.AdminNome</span>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger btn-sm ms-2">Logout</a>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <!-- Cards de Estatísticas -->
            <div class="row mb-4">
                <div class="col-md-2">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">@ViewBag.TotalProdutos</h5>
                            <p class="card-text">Produtos</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">@ViewBag.TotalCategorias</h5>
                            <p class="card-text">Categorias</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">@ViewBag.TotalUsuarios</h5>
                            <p class="card-text">Usuários</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">@ViewBag.TotalAdmins</h5>
                            <p class="card-text">Admins</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">@ViewBag.TotalCarrinhos</h5>
                            <p class="card-text">Carrinhos</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Menu de Navegação -->
            <div class="row">
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Produtos</h5>
                            <p class="card-text">Gerenciar produtos do sistema</p>
                            <a asp-action="Produtos" class="btn btn-primary">Gerenciar</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Categorias</h5>
                            <p class="card-text">Gerenciar categorias</p>
                            <a asp-action="Categorias" class="btn btn-primary">Gerenciar</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Usuários</h5>
                            <p class="card-text">Gerenciar usuários do sistema</p>
                            <a asp-action="Usuarios" class="btn btn-primary">Gerenciar</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Carrinhos</h5>
                            <p class="card-text">Visualizar carrinhos de compra</p>
                            <a asp-action="Carrinhos" class="btn btn-primary">Visualizar</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Administradores</h5>
                            <p class="card-text">Gerenciar administradores</p>
                            <a asp-action="Admins" class="btn btn-primary">Gerenciar</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Estatísticas</h5>
                            <p class="card-text">Relatórios e estatísticas</p>
                            <a asp-action="Estatisticas" class="btn btn-primary">Visualizar</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">CRUD Produtos</h5>
                            <p class="card-text">Acesso direto ao CRUD</p>
                            <a asp-controller="Produto" asp-action="Index" class="btn btn-secondary">Acessar</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">CRUD Categorias</h5>
                            <p class="card-text">Acesso direto ao CRUD</p>
                            <a asp-controller="Categoria" asp-action="Index" class="btn btn-secondary">Acessar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
