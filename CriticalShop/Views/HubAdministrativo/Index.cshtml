@{
    ViewData["Title"] = "Hub Administrativo";
}
<link rel="stylesheet" href="@Url.Content("~/css/HubAdmin/hub.css")">
<div class="container">
        <!-- Header -->
        <div class="admin-header">
            <h2>Hub Administrativo</h2>
            <div class="admin-info">
                <span class="welcome-badge">Bem-vindo, @ViewBag.AdminNome</span>
                <a asp-controller="Auth" asp-action="Logout" class="logout-btn">Logout</a>
            </div>
        </div>

        <!-- Alert Messages -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <!-- Statistics Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">@ViewBag.TotalProdutos</div>
                <div class="stat-label">Produtos</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@ViewBag.TotalCategorias</div>
                <div class="stat-label">Categorias</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@ViewBag.TotalUsuarios</div>
                <div class="stat-label">Usuários</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@ViewBag.TotalAdmins</div>
                <div class="stat-label">Admins</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@ViewBag.TotalCarrinhos</div>
                <div class="stat-label">Carrinhos</div>
            </div>
        </div>

        <!-- Navigation Menu -->
        <div class="menu-grid">
            <!-- First Row -->
            <div class="menu-card">
                <h5>Produtos</h5>
                <p>Gerenciar produtos do sistema</p>
                <a asp-action="Produtos" class="btn-primary">Gerenciar</a>
            </div>
            <div class="menu-card">
                <h5>Categorias</h5>
                <p>Gerenciar categorias</p>
                <a asp-action="Categorias" class="btn-primary">Gerenciar</a>
            </div>
            <div class="menu-card">
                <h5>Usuários</h5>
                <p>Gerenciar usuários do sistema</p>
                <a asp-action="Usuarios" class="btn-primary">Gerenciar</a>
            </div>
            <div class="menu-card">
                <h5>Carrinhos</h5>
                <p>Visualizar carrinhos de compra</p>
                <a asp-action="Carrinhos" class="btn-primary">Visualizar</a>
            </div>

            <!-- Second Row -->
            <div class="menu-card">
                <h5>Administradores</h5>
                <p>Gerenciar administradores</p>
                <a asp-action="Admins" class="btn-primary">Gerenciar</a>
            </div>
            <div class="menu-card">
                <h5>Estatísticas</h5>
                <p>Relatórios e estatísticas</p>
                <a asp-action="Estatisticas" class="btn-primary">Visualizar</a>
            </div>
            <div class="menu-card">
                <h5>CRUD Produtos</h5>
                <p>Acesso direto ao CRUD</p>
                <a asp-controller="Produto" asp-action="Index" class="btn-secondary">Acessar</a>
            </div>
            <div class="menu-card">
                <h5>CRUD Categorias</h5>
                <p>Acesso direto ao CRUD</p>
                <a asp-controller="Categoria" asp-action="Index" class="btn-secondary">Acessar</a>
            </div>
        </div>
    </div>

    <script>
        // Simple animation on load
        document.addEventListener('DOMContentLoaded', function() {
            // Add hover effects
            const cards = document.querySelectorAll('.stat-card, .menu-card');
            cards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-5px)';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });
        });
    </script>