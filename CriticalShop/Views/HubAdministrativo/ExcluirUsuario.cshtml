@model CriticalShop.Models.Usuario

@{
    ViewData["Title"] = "Excluir Usuário";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Excluir Usuário</h2>
                <a asp-action="Usuarios" class="btn btn-secondary">Voltar</a>
            </div>

            <div class="alert alert-warning">
                <h4>Atenção!</h4>
                <p>Tem certeza que deseja excluir este usuário?</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Nome</dt>
                        <dd class="col-sm-9">@Model.Nome</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3">CPF</dt>
                        <dd class="col-sm-9">@Model.Cpf</dd>

                        <dt class="col-sm-3">Telefone</dt>
                        <dd class="col-sm-9">@(Model.Telefone ?? "Não informado")</dd>

                        <dt class="col-sm-3">Data de Cadastro</dt>
                        <dd class="col-sm-9">@Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inativo</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Carrinhos</dt>
                        <dd class="col-sm-9">@(Model.Carrinhos?.Count ?? 0)</dd>

                        <dt class="col-sm-3">Avaliações</dt>
                        <dd class="col-sm-9">@(Model.Avaliacoes?.Count ?? 0)</dd>
                    </dl>

                    <form asp-action="ExcluirUsuario" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
                            <a asp-action="Usuarios" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
