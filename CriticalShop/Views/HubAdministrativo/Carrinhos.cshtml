@model IEnumerable<CriticalShop.Models.Carrinho>

@{
    ViewData["Title"] = "Gerenciar Carrinhos";
}
<link rel="stylesheet" href="@Url.Content("~/css/crudProdutos/style.css")">
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Gerenciar Carrinhos</h2>
                <div>
                    <a asp-action="Index" class="btn btn-secondary">Voltar ao Hub</a>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Usuário</th>
                            <th>Session ID</th>
                            <th>Data Criação</th>
                            <th>Itens</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var carrinho in Model)
                        {
                            <tr>
                                <td>@carrinho.Id</td>
                                <td>@carrinho.Usuario?.Nome</td>
                                <td>@carrinho.SessionId</td>
                                <td>@carrinho.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@carrinho.Itens?.Count</td>
                                <td>R$ @(carrinho.Itens?.Sum(i => i.PrecoFinal) ?? 0).ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
