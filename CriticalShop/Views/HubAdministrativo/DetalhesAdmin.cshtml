@model CriticalShop.Models.Admin

@{
    ViewData["Title"] = "Detalhes do Administrador";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Detalhes do Administrador</h2>
                <a asp-action="Admins" class="btn btn-secondary">Voltar</a>
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Nome</dt>
                        <dd class="col-sm-9">@(Model.Nome ?? "Não informado")</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3">Data de Cadastro</dt>
                        <dd class="col-sm-9">@Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Tipo</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsSuperAdmin)
                            {
                                <span class="badge bg-warning">Super Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Admin</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inativo</span>
                            }
                        </dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-action="EditarAdmin" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
                        <a asp-action="ExcluirAdmin" asp-route-id="@Model.Id" class="btn btn-danger">Excluir</a>
                        <a asp-action="Admins" class="btn btn-secondary">Voltar à Lista</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
