@model IEnumerable<CriticalShop.Models.Produto>

@{
    ViewData["Title"] = "Gerenciar Produtos";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Gerenciar Produtos</h2>
                <div>
                    <a asp-controller="Produto" asp-action="Create" class="btn btn-success">Novo Produto</a>
                    <a asp-action="Index" class="btn btn-secondary">Voltar ao Hub</a>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Preço</th>
                            <th>Categoria</th>
                            <th>Desconto</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var produto in Model)
                        {
                            <tr>
                                <td>@produto.Id</td>
                                <td>@produto.Nome</td>
                                <td>R$ @produto.Preco.ToString("F2")</td>
                                <td>@produto.Categoria?.Nome</td>
                                <td>@(produto.Desconto?.Valor)%</td>
                                <td>
                                    <a asp-controller="Produto" asp-action="Details" asp-route-id="@produto.Id" class="btn btn-info btn-sm">Detalhes</a>
                                    <a asp-controller="Produto" asp-action="Edit" asp-route-id="@produto.Id" class="btn btn-warning btn-sm">Editar</a>
                                    <a asp-controller="Produto" asp-action="Delete" asp-route-id="@produto.Id" class="btn btn-danger btn-sm">Excluir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
