@model IEnumerable<CriticalShop.Models.Categoria>

@{
    ViewData["Title"] = "Gerenciar Categorias";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Gerenciar Categorias</h2>
                <div>
                    <a asp-controller="Categoria" asp-action="Create" class="btn btn-success">Nova Categoria</a>
                    <a asp-action="Index" class="btn btn-secondary">Voltar ao Hub</a>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Categoria Pai</th>
                            <th>Subcategorias</th>
                            <th>Produtos</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var categoria in Model)
                        {
                            <tr>
                                <td>@categoria.Id</td>
                                <td>@categoria.Nome</td>
                                <td>@categoria.Parent?.Nome</td>
                                <td>@categoria.SubCategorias?.Count</td>
                                <td>@categoria.Produtos?.Count</td>
                                <td>
                                    <a asp-controller="Categoria" asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-info btn-sm">Detalhes</a>
                                    <a asp-controller="Categoria" asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-warning btn-sm">Editar</a>
                                    <a asp-controller="Categoria" asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-danger btn-sm">Excluir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
