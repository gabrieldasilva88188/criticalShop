@model CriticalShop.Models.Usuario

@{
    ViewData["Title"] = "Detalhes do Usuário";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Detalhes do Usuário</h2>
                <a asp-action="Usuarios" class="btn btn-secondary">Voltar</a>
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Nome</dt>
                        <dd class="col-sm-9">@Model.Nome</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3">CPF</dt>
                        <dd class="col-sm-9">@Model.Cpf</dd>

                        <dt class="col-sm-3">Telefone</dt>
                        <dd class="col-sm-9">@(Model.Telefone ?? "Não informado")</dd>

                        <dt class="col-sm-3">Endereço</dt>
                        <dd class="col-sm-9">@(Model.Endereco ?? "Não informado")</dd>

                        <dt class="col-sm-3">Data de Nascimento</dt>
                        <dd class="col-sm-9">@(Model.DataNascimento?.ToString("dd/MM/yyyy") ?? "Não informado")</dd>

                        <dt class="col-sm-3">Data de Cadastro</dt>
                        <dd class="col-sm-9">@Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inativo</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Carrinhos</dt>
                        <dd class="col-sm-9">@(Model.Carrinhos?.Count ?? 0)</dd>

                        <dt class="col-sm-3">Avaliações</dt>
                        <dd class="col-sm-9">@(Model.Avaliacoes?.Count ?? 0)</dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-action="EditarUsuario" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
                        <a asp-action="ExcluirUsuario" asp-route-id="@Model.Id" class="btn btn-danger">Excluir</a>
                        <a asp-action="Usuarios" class="btn btn-secondary">Voltar à Lista</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
