@model CriticalShop.Models.Categoria
@{
    ViewData["Title"] = "Editar Categoria";
}
<h2>Editar Categoria</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ParentId" class="form-label">Categoria Pai (Opcional)</label>
        <select asp-for="ParentId" class="form-select">
            <option value="">Nenhuma</option>
            @foreach (var cat in ViewBag.Categorias)
            {
                var selected = cat.Id == Model.ParentId ? "selected" : "";
                <option value="@cat.Id" selected="@selected">@cat.Nome</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-warning">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>
