@model CriticalShop.Models.Categoria
@{
    ViewData["Title"] = "Excluir Categoria";
}
<h2>Excluir Categoria</h2>
<div class="alert alert-danger">Tem certeza que deseja excluir esta categoria?</div>
<div class="mb-3">
    <strong>ID:</strong> @Model.Id
</div>
<div class="mb-3">
    <strong>Nome:</strong> @Model.Nome
</div>
<div class="mb-3">
    <strong>Categoria Pai:</strong> @(Model.Parent?.Nome ?? "-")
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
