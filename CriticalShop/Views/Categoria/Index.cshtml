@model IEnumerable<CriticalShop.Models.Categoria>
@{
    ViewData["Title"] = "Gerenciar Categorias";
}
<link rel="stylesheet" href="@Url.Content("~/css/crudProdutos/style.css")">


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

  
            <h2>Gerenciar Categorias</h2>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nova Categoria
            </a>
            <br />  <br />  
            
    </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Categoria Pai</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in Model)
                    {
                        <tr>
                            <td>@categoria.Id</td>
                            <td>
                                <strong>@categoria.Nome</strong>
                                @if (categoria.SubCategorias?.Any() == true)
                                {
                                    <br>
                                    <small class="text-muted">
                                        <i class="fas fa-sitemap"></i> 
                                        @categoria.SubCategorias.Count subcategorias
                                    </small>
                                }
                            </td>
                            <td>
                                @if (categoria.Parent != null)
                                {
                                    <span class="badge bg-primary">@categoria.Parent.Nome</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                  <a asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-info btn-sm" title="Ver detalhes">
                                    <i class="fas fa-eye">Detalhes</i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-warning btn-sm" title="Editar">
                                    <i class="fas fa-edit">Editar</i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-danger btn-sm" title="Excluir">
                                    <i class="fas fa-trash">Excluir</i>
                                </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">Nenhuma categoria encontrada</h4>
                <p class="text-muted">Clique em "Nova Categoria" para começar a adicionar categorias.</p>
            </div>
        }

@section Scripts {
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js"></script>
}