@model CriticalShop.Models.Categoria
@{
    ViewData["Title"] = "Nova Categoria";
}
<h2>Nova Categoria</h2>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ParentId" class="form-label">Categoria Pai (Opcional)</label>
        <select asp-for="ParentId" class="form-select">
            <option value="">Nenhuma</option>
            @foreach (var cat in ViewBag.Categorias)
            {
                <option value="@cat.Id">@cat.Nome</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>
