@model CriticalShop.Models.Produto
<link rel="stylesheet" href="@Url.Content("~/css/crudProdutos/styleEdit.css")">

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-edit"></i> Editar Produto
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Nome" class="form-label">Nome do Produto</label>
                                    <input asp-for="Nome" class="form-control" placeholder="Digite o nome do produto" />
                                    <span asp-validation-for="Nome" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 preco-input">
                                <div class="mb-3">
                                    <label asp-for="Preco" class="form-label">Preço</label>
                                    <div class="input-group">
                                        <span class="input-group-text">R$</span>
                                        <input asp-for="Preco" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="Preco" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CategoriaId" class="form-label">Categoria</label>
                                    <select asp-for="CategoriaId" class="form-select">
                                        <option value="">Selecione uma categoria         </option>
                                        @foreach (var categoria in ViewBag.Categorias)
                                        {
                                            <option value="@categoria.Id" selected="@(categoria.Id == Model.CategoriaId)">@categoria.Nome</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="DescontoId" class="form-label">Desconto (Opcional)</label>
                                    <select asp-for="DescontoId" class="form-select">
                                        <option value="">Sem desconto</option>
                                        @if (ViewBag.Descontos != null)
                                        {
                                            @foreach (var desconto in ViewBag.Descontos)
                                            {
                                                <option value="@desconto.Id" selected="@(desconto.Id == Model.DescontoId)">@desconto.Valor% OFF</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="DescontoId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Img" class="form-label">URL da Imagem</label>
                                    <input asp-for="Img" class="form-control" type="url" placeholder="https://exemplo.com/imagem.jpg" />
                                    <div class="form-text">Cole aqui o link da imagem do produto</div>
                                    <span asp-validation-for="Img" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Img))
                        {
                            <div class="mb-3">
                                <label class="form-label">Imagem Atual</label>
                                <div>
                                    <img src="@Model.Img" alt="@Model.Nome" style="max-width: 200px; max-height: 200px;" class="img-thumbnail" />
                                </div>
                                <small class="text-muted">URL: @Model.Img</small>
                            </div>
                        }

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Voltar
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Atualizar Produto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js"></script>
}
