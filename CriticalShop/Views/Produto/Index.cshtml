@model IEnumerable<CriticalShop.Models.Produto>
<link rel="stylesheet" href="@Url.Content("~/css/crudProdutos/style.css")">

@{
    ViewData["Title"] = "Gerenciar Produtos";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gerenciar Produtos</h2>
        
    </div>

    <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Novo Produto
    </a>
    <br />  <br />  

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Imagem</th>
                    <th>Nome</th>
                    <th>Preço</th>
                    <th>Categoria</th>
                    <th>Desconto</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Img))
                            {
                                <img src="@item.Img" alt="@item.Nome" style="width: 50px; height: 50px; object-fit: cover;" class="rounded">
                            }
                            else
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <i class="fas fa-image"></i>
                                </div>
                            }
                        </td>
                        <td>@item.Nome</td>
                        <td>
                            @{
                                var precoOriginal = item.Preco;
                                var precoComDesconto = item.Desconto != null ? precoOriginal * (1 - item.Desconto.Valor / 100.0) : precoOriginal;
                                var campanhaAtiva = ViewBag.CampanhaAtiva == true;
                                var precoCampanha = campanhaAtiva ? precoComDesconto * 0.5 : precoComDesconto;
                            }
                            @if (campanhaAtiva)
                            {
                                <div>
                                    <span class="text-decoration-line-through text-muted">@precoComDesconto.ToString("C")</span>
                                    <br>
                                    <span class="text-danger fw-bold">@precoCampanha.ToString("C")</span>
                                </div>
                            }
                            else if (item.Desconto != null)
                            {
                                <div>
                                    <span class="text-decoration-line-through text-muted">@precoOriginal.ToString("C")</span>
                                    <br>
                                    <span class="text-success fw-bold">@precoComDesconto.ToString("C")</span>
                                </div>
                            }
                            else
                            {
                                <span>@precoOriginal.ToString("C")</span>
                            }
                        </td>
                        <td>@(item.Categoria?.Nome ?? "Sem categoria")</td>
                        <td>
                            @if (item.Desconto != null)
                            {
                                <span class="badge bg-danger">@item.Desconto.Valor% OFF</span>
                            }
                            else
                            {
                                <span class="text-muted">Sem desconto</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="Ver detalhes">
                                    <i class="fas fa-eye">Detalhes</i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Editar">
                                    <i class="fas fa-edit">Editar</i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Excluir">
                                    <i class="fas fa-trash">Excluir</i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">Nenhum produto encontrado</h4>
            <p class="text-muted">Clique em "Novo Produto" para começar a adicionar produtos.</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js"></script>
}
